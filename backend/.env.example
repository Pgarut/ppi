# Backend Environment Variables — PPI Madrasah
# Copy to .env and fill in values before running wrangler deploy

# JWT Secrets (gunakan string acak yang panjang)
JWT_SECRET=change-this-to-a-random-secret-key-min-32-chars
JWT_REFRESH_SECRET=change-this-to-another-random-secret-key-min-32

# CORS Origin (domain frontend yang diizinkan)
CORS_ORIGIN=https://ppi-madrasah.com,https://admin.ppi-madrasah.com

# Cloudflare D1
D1_DATABASE_ID=your-d1-database-id-here
CLOUDFLARE_ACCOUNT_ID=your-account-id-here
